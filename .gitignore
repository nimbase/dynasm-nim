.DS_Store
nimcache/
nimblecache/
htmldocs/
testresults/
/tests/*
!/tests/bench
!/tests/*.nim
!/tests/*.nims
# Build outputs and local tool state (never commit)
bin/
bench/
clue.lock
# examples/: only sources stay tracked; compiled binaries, nimcache,
# logs or any other byproducts of `nim c` / `nim r` next to the
# sources are never committed
examples/*
!examples/*.nim
!examples/*.sh
!examples/*.nims
